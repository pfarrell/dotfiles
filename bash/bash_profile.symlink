for env in $(find ~/.dotfiles/ -name 'env.sh'); do source $env; done;
for env in $(find ~/.dotfiles/ -name 'private_env.sh'); do source $env; done;

[[ -f ~/.bashrc ]] && . ~/.bashrc

# export GPG_TTY=$(tty)

[[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] && . "/opt/homebrew/etc/profile.d/bash_completion.sh"

pref=${HOMEBREW_PREFIX:-/opt/homebrew}
if [ -f "$pref/opt/bash-git-prompt/share/gitprompt.sh" ]; then
  __GIT_PROMPT_DIR=$pref/opt/bash-git-prompt/share
  GIT_PROMPT_ONLY_IN_REPO=1
  source "$pref/opt/bash-git-prompt/share/gitprompt.sh"
fi
